{
  "name": "@fiken-mcp/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc && tsc -p test && tsc -p scripts",
    "typecheck": "tsc && tsc -p test && tsc -p scripts",
    "test": "vitest run --exclude 'test/integration/**'",
    "gen:types": "openapi-typescript ../../spec/fiken-openapi.yaml --output src/fiken/types.gen.ts && node scripts/gen-gateway.ts",
    "test:integration": "vitest run test/integration --no-file-parallelism"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "^26.6.5",
    "openapi-typescript": "^7.13.0",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "openapi-fetch": "^0.17.0",
    "zod": "^4.6.7"
  }
}
