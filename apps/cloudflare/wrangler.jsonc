{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fiken-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // global_fetch_strictly_public is required for Client ID Metadata Documents (SSRF protection).
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "fiken.mcp.wollums.no", "custom_domain": true }],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "2fa7dcca57764232a38d4e304bc3e745" }],
  "durable_objects": {
    "bindings": [{ "name": "FIKEN_USER_QUEUE", "class_name": "FikenUserQueue" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FikenUserQueue"] }],
  "observability": {
    "enabled": true,
    // Our own log lines only. Invocation logs would store request URLs, which carry upload tokens
    // and OAuth codes.
    "logs": { "enabled": true, "invocation_logs": false }
  }
  // Secrets: FIKEN_CLIENT_ID, FIKEN_CLIENT_SECRET (wrangler secret put).
}
